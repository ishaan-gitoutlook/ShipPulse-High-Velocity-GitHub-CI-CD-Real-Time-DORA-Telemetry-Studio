# ==============================================================================
# ShipPulse - Environment Variables Template
# Copy this file to .env and populate with your actual keys.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Python Microservices API Gateway (Port 5000)
GATEWAY_PORT=5000
GATEWAY_ENV=development
CORS_ORIGIN=http://localhost:3000

# GitHub OAuth Application Credentials
# Create one at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000 (or your deployment domain)
# Authorization callback URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Google Gemini API Key
# Obtain one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Webhook Shared Secret (Optional - for GitHub push event webhook verification)
WEBHOOK_SECRET=whsec_replace_with_secure_random_hex_or_string
