# ==============================================================================
# ShipPulse - Git Ignore Configuration
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.local
.env.*.local
.env.*
!.env.example

# IDEs, Agent Caches & Local Metadata
.antigravity/
**/.antigravity/
.idea/
**/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Node dependencies & builds
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
out/
tmp/
out-tsc/
bazel-out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Angular build cache
.angular/
**/.angular/
.sass-cache/

# Python bytecode, virtual environments & test caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
env/
ENV/
.venv/

# Testing artifacts
coverage/
testem.log
connect.lock
__screenshots__/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
