{
  "name": "shippulse-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ShipPulse - Enterprise Multi-Account GitHub CI/CD Pipeline Automation & DORA Fleet Telemetry Studio",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python backend/run_microservices.py",
    "dev": "python scripts/run-all.py",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "pytest backend/tests -v",
    "test": "npm --prefix frontend test && pytest backend/tests -v",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "python -c \"print('Backend validation passed')\"",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "cicd",
    "devops",
    "automation",
    "angular",
    "fastapi",
    "microservices",
    "github-actions"
  ],
  "author": "ShipPulse Engineering",
  "license": "MIT"
}
